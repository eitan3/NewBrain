+# ---------------------------------------------------------------- VRAM savers (activation checkpointing; all off by default)
+# A segment run by ck_run keeps only its inputs for backward and is re-run (recomputed) in backward. Same maths:
+# the recompute repeats the same ops on the same inputs (non-reentrant checkpoint, RNG state restored), and
+#   * every spike threshold the segment reads is the value its FIRST run saw (homeostasis edits alpha.data in place
+#     during the forward, so later passes / the end of the step would otherwise leak into the recompute): ck_param;
+#   * side effects (homeostasis EMA / alpha nudges) run on the first run only: ck_recompute() is True in the recompute.
+_CK = None   # the box of the checkpointed segment being run (None = not inside one)
+
+
+class _AsValue(torch.autograd.Function):
+    """The value v (a first-run snapshot) in place of the parameter p. Only its forward matters: a non-reentrant
+    checkpoint's backward runs the ORIGINAL graph (the recomputed graph only supplies the saved tensors), so this node
+    only makes the recompute save the same tensors as the first run (an output that requires grad, like p)."""
+
+    @staticmethod
+    def forward(ctx, p, v):
+        return v.clone()
+
+    @staticmethod
+    def backward(ctx, g):
+        return g, None
+
+
+def ck_param(mod, p):
+    """p as the first run of the current checkpointed segment saw it (p itself outside a segment)."""
+    box = _CK
+    if box is None:
+        return p
+    snap = box.setdefault("snap", {})
+    if box["n"] == 1:
+        snap.setdefault(id(mod), []).append(p.detach().clone())
+        return p
+    i = box.setdefault("used", {}).get(id(mod), 0)
+    box["used"][id(mod)] = i + 1
+    return _AsValue.apply(p, snap[id(mod)][i])
+
+
+def ck_recompute():
+    """True inside the recompute of a checkpointed segment (skip side effects)."""
+    return _CK is not None and _CK["n"] > 1
+
+
+def ck_ready(*spikes):
+    """A segment may be checkpointed: grad on, not nested in another segment, its spikes calibrated (the one-time
+    calibration draws from the global RNG and must not be re-run or skipped by a recompute)."""
+    return torch.is_grad_enabled() and _CK is None and all(s.is_calibrated() for s in spikes)
+
+
+def ck_run(fn, *args):
+    """fn(*args) as an activation-checkpointed segment (non-reentrant, RNG state preserved). fn's tensor inputs
+    must be passed in args (positional); everything else is bound by the caller."""
+    box = {"n": 0}
+
+    def seg(*a):
+        global _CK
+        prev = _CK
+        box["n"] += 1
+        box["used"] = {}
+        _CK = box
+        try:
+            return fn(*a)
+        finally:
+            _CK = prev
+    return torch.utils.checkpoint.checkpoint(seg, *args, use_reentrant=False, preserve_rng_state=True)
 
 
