+        d = self.pos[:, None] - self.pos[None]
+        dr, dc = d[..., 0].abs() % rows, d[..., 1].abs() % cols
+        dr, dc = torch.minimum(dr, rows - dr), torch.minimum(dc, cols - dc)
+        K = torch.exp(-(dr ** 2 + dc ** 2) / (2 * sigma ** 2))
+        K.fill_diagonal_(0)
