+# ---------------------------------------------------------------- v4: accumulation, head groups, growing waves
+def wave_loop(**kw):
+    """The v4 base: waves + workspace v2, no vector state (double precision)."""
+    cfg = dict(state="", waves=True, slots=4, ws_direct=True, heads=2)
+    cfg.update(kw)
+    return tiny_loop(**cfg)
+
