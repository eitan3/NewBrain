+def masked_std(x, v, nv):
+    """Per-dimension std over the valid (b, t): sqrt(mean_v(x^2) - mean_v(x)^2 + 1e-6) (no nonzero(), no sync)."""
+    m = (x * v).sum((0, 1)) / nv
+    m2 = (x * x * v).sum((0, 1)) / nv
+    return (m2 - m * m + 1e-6).clamp(min=1e-12).sqrt()
+
