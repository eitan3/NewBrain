+            move = ((mu - prev[l]).norm(dim=-1) / mu.norm(dim=-1).clamp(min=1e-6) if prev is not None
+                    else torch.zeros_like(var_u))
+            u += [var_u, torch.log1p(move)]
+        return torch.stack(u, -1)
