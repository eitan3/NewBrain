+            return torch.einsum("lbtr,ldr->btd", torch.einsum("lbtd,lrd->lbtr", mu, self.inj_a), self.inj_b)
+        mu = torch.stack(mus).to(self.inj.dtype)
+        return torch.einsum("lbtd,lod->bto", mu, self.inj)
