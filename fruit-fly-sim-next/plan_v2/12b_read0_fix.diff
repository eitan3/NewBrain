+# ---------------------------------------------------------------- --mem-read0 0: nothing is read before pass 1
+def test_18_read0_off_means_no_memory_use_before_pass_1():
+    for read0 in (1, 0):
+        m = mem_loop(mem_read0=read0)
+        m.eval()
+        calls = []
+        sh, pr = m.mem.read_shared, m.mem.private
+        m.mem.read_shared = lambda *a, **k: (calls.append("shared"), sh(*a, **k))[1]
+        m.mem.private = lambda *a, **k: (calls.append("private"), pr(*a, **k))[1]
+        hs = m._hier_step
+        steps = []
+        m._hier_step = lambda s, read, address, k=0: (steps.append((k, read, address)), hs(s, read, address, k))[1]
+        x = torch.randint(1, 50, (2, 16))
+        m.K = 1  # one pass: the only possible memory use is the one before it (after the last pass nothing is read)
+        with torch.no_grad():
+            m(x)
+        if read0:
+            assert steps[0] == (-1, True, True) and "shared" in calls and "private" in calls
+        else:
+            assert all(k >= 0 for k, _, _ in steps) and not any(a for _, _, a in steps) and calls == []
+        calls.clear(); steps.clear()
+        m.K = 3
+        with torch.no_grad():
+            m(x)
+        n_shared = calls.count("shared")
+        assert n_shared == (3 if read0 else 2)  # reads after passes 1 and 2 (+ the pre-pass read when on)
+        assert sum(1 for k, _, a in steps if a and k == -1) == read0
