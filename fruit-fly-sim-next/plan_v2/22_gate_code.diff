+                d["resid_top"] = r[isA].mean().item()
+                d["resid_explore"] = r[~isA & (r != 0)].mean().item() if bool((~isA & (r != 0)).any()) else float("nan")
+            nz = r != 0  # (closed positions have no read: M = 0 there)
