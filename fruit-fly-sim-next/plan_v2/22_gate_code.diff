+    # ---- selection
+    def thr(self, k):
+        """theta_k (a 0-dim tensor), -inf before the first training cut-off (c = 1)."""
+        i = min(max(k, 0), GATE_NTHETA - 1)
+        return torch.where(self.theta_ok[i], self.theta[i], torch.full_like(self.theta[i], float("-inf")))
