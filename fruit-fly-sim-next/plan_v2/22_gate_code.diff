+    finally:
+        model.mem_gate_eval, model.gate_eval_rate, model.gate_oracle_b = old
+        model.train()
+    b = torch.cat(acc["b"]).double()
+    pos = b.clamp(min=0).sum().item()
+    out = {f"gate_loss_{m}": torch.cat(v).mean().item() for m, v in ce_m.items()}
+    for m, v in frac.items():
