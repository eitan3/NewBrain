"""CHANGING-FACTS memory eval for the FastMem runs (--memory fastmem --fastmem-stream 1, per-stream state): stream the
val streams of X:/Datasets/world_change_mix through a checkpoint IN ORDER and score the later questions (answers
outside the 512-token context). The FastMem port of eval_change.py (same items, candidates, metrics, report).

    CPU:  python -B eval_change_fastmem.py --ckpt <run>/ckpt_2000.pt --max-streams 4 --max-seqs 12
    GPU:  python -B eval_change_fastmem.py --ckpt <run>/ckpt_2000.pt --device cuda       (16 GB cap, 2 threads)

The model code comes from <run>/code_snapshot (no bytecode written); the checkpoint loads on the CPU, then
<ckpt>.memory.pt strict (read only; sha256 before / after with --hash-file 1), then .to(device), eval().

How FastMem carries state (fastmem.py): M [streams, S, H, dk, dv] / Mg [streams, G, 1, dk, dv]. A forward reads the
carried start state only when it is "live" (begin_forward: bm.training and bm.train_forward and grad enabled) and the
batch rows' streams were named (set_streams; starts=True resets a stream to zero); otherwise every sequence starts
from zero memory. The write = the scan's end state at the read pass (min(read_pass, K-1)), computed under no_grad
(merge) when live, held in _pend and committed to M[stream] by after_backward(). No gradient / optimizer is needed
for the write itself; grad is switched on inside FastMem's write pass only (its own set_grad_enabled), with no
parameter requiring grad, so no graph is kept. The live flag also turns on exploration of the pre-read gate:
explore is set to 0 here.

Modes (same streams; batch row b = stream b, sequence j at step j, as the stream loader trains):
  off         memory_api memory_off: bm.enabled False -> the exact no-memory code path (module never called)
  on_nowrite  memory on, not live: every sequence reads zero start memory (+ its own in-sequence scan) = control
  on_write    memory on, live (begin_forward patched: _live True, explore 0, ckpt off), set_streams(rows, starts at
              j == 0) -> sequence j reads the stream's state written by sequences < j; after the forward,
              after_backward() commits the end states (no backward, no optimizer, after_step never called).
Brain params+buffers, memory params (incl. D) and memory buffers other than M / Mg (D's moments) are checksum-asserted
unchanged; M / Mg / n_fwd are restored after on_write. Self-check: at sequence 0 on_write must equal on_nowrite.

Metrics per question (answer = object tokens; gold logits at pos-1 ..): exact (all answer tokens argmax), first, logp/tok,
vrank (rank of the gold first token in the vocabulary), crank (rank among the relation's candidate first tokens).
By relation, form and distance (1-4 sequences after the fact). Output: world_change/<run>_<ckpt>_change_fastmem[_tag].json
+ .txt (never into runs/).
"""
import os
import sys
from pathlib import Path

argv = sys.argv


def _opt(name, default=None):
    if name in argv[:-1]:
        return argv[argv.index(name) + 1]
    for x in argv:
        if x.startswith(name + "="):
            return x.split("=", 1)[1]
    return default


DEV = _opt("--device", "cpu")
sys.dont_write_bytecode = True
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
if DEV != "cuda":
    os.environ["CUDA_VISIBLE_DEVICES"] = "-1"
os.environ["OMP_NUM_THREADS"] = "2"
os.environ["MKL_NUM_THREADS"] = "2"
CKPT = Path(_opt("--ckpt", r"C:\Eitan\Python\NewBrain\runs\world_fastmem_change_12k\last.pt"))
SNAP = CKPT.parent / "code_snapshot"
assert SNAP.exists(), f"no {SNAP}"
sys.path.insert(0, str(SNAP))

import torch                                        # noqa: E402
torch.set_num_threads(2)
if DEV == "cuda":
    _total = torch.cuda.get_device_properties(0).total_memory
    torch.cuda.set_per_process_memory_fraction(min(1.0, 16e9 / _total), torch.device("cuda", 0))
import argparse                                     # noqa: E402
import hashlib                                      # noqa: E402
import json                                         # noqa: E402
import time                                         # noqa: E402
import types                                        # noqa: E402
from collections import defaultdict                 # noqa: E402

import numpy as np                                  # noqa: E402
import torch.nn.functional as F                     # noqa: E402

import eval_world as ew                             # noqa: E402  (the snapshot's copy)
import memory_api                                   # noqa: E402
from fastmem import FastMem                         # noqa: E402

HERE = Path(__file__).resolve().parent
RELS = ["city", "job", "pet", "year", "friend"]


def args():
    ap = argparse.ArgumentParser()
    ap.add_argument("--ckpt", default=str(CKPT))
    ap.add_argument("--config", default="")
    ap.add_argument("--data", default="X:/Datasets/world_change_mix")
    ap.add_argument("--src", default="X:/Datasets/wiki_world_mix", help="world.json (the attribute vocabularies)")
    ap.add_argument("--device", default="cpu", choices=["cpu", "cuda"])
    ap.add_argument("--k", type=int, default=6, help="loop passes (the run's k_mean)")
    ap.add_argument("--capacity", default="dropless")
    ap.add_argument("--max-streams", "--streams", dest="streams", type=int, default=0,
                    help="first N val streams (0 = all 16; = the batch)")
    ap.add_argument("--max-seqs", type=int, default=0, help="first N sequences per stream (0 = all 256)")
    ap.add_argument("--modes", default="off,on_nowrite,on_write")
    ap.add_argument("--hash-file", type=int, default=1, help="sha256 of the memory file before / after")
    ap.add_argument("--tag", default="")
    ap.add_argument("--out", default="")
    ap.add_argument("--threads", type=int, default=2)
    a, _ = ap.parse_known_args()
    assert a.device == DEV
    return a


# ---------------------------------------------------------------- checksums
def _h(h, v):
    if torch.is_tensor(v):
        t = v.detach().cpu().contiguous()
        h.update(f"{t.dtype}{tuple(t.shape)}".encode())
        if t.numel():
            h.update(t.reshape(-1).view(torch.uint8).numpy())
    else:
        h.update(repr(v).encode())


def brain_checksum(model):
    h = hashlib.blake2b(digest_size=8)
    for n, t in sorted(list(model.named_parameters()) + list(model.named_buffers()), key=lambda x: x[0]):
        if not n.startswith("bm."):
            h.update(n.encode())
            _h(h, t)
    return h.hexdigest()


def mem_param_checksum(bm):
    h = hashlib.blake2b(digest_size=8)
    for n, p in sorted(bm.named_parameters()):
        h.update(n.encode())
        _h(h, p)
    _h(h, bm.D)
    _h(h, bm.D_g)
    return h.hexdigest()


def mem_buf_checksum(bm, skip=("M", "Mg")):
    h = hashlib.blake2b(digest_size=8)
    for n, b in sorted(bm.named_buffers()):
        if n not in skip:
            h.update(n.encode())
            _h(h, b)
    return h.hexdigest()


def sha256_file(p, chunk=1 << 24):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        while True:
            b = f.read(chunk)
            if not b:
                break
            h.update(b)
    return h.hexdigest()[:16]


# ---------------------------------------------------------------- the live (writing) context
class Live:
    """FastMem's training-path write without training: _live forced on at begin_forward, exploration 0, the memory's
    activation checkpointing off, no parameter requires grad (FastMem enables grad inside its write pass only)."""

    def __init__(self, model):
        self.model, self.bm = model, model.bm

    def __enter__(self):
        bm = self.bm
        self.keep = dict(explore=bm.explore, ckpt=bm.ckpt, n_fwd=bm.n_fwd, M=bm.M.clone(), Mg=bm.Mg.clone())
        bm.explore, bm.ckpt = 0.0, False
        self.req = {n: p.requires_grad for n, p in self.model.named_parameters()}
        for p in self.model.parameters():
            p.requires_grad_(False)

        def begin_forward():
            bm._live = True
            bm._fw = None
            bm.n_fwd += 1
        bm.begin_forward = begin_forward
        self.n_commit = 0
        return self

    def before(self, B, j):
        self.bm.set_streams(list(range(B)), [j == 0] * B)

    def after(self):
        assert self.bm._pend is not None, "on_write: the forward produced no write"
        self.bm.after_backward()
        self.n_commit += 1

    def __exit__(self, *exc):
        bm = self.bm
        del bm.begin_forward                       # (back to the class method)
        bm._live, bm._fw, bm._pend, bm.streams = False, None, None, None
        bm.explore, bm.ckpt, bm.n_fwd = self.keep["explore"], self.keep["ckpt"], self.keep["n_fwd"]
        with torch.no_grad():
            bm.M.copy_(self.keep["M"])
            bm.Mg.copy_(self.keep["Mg"])
        for n, p in self.model.named_parameters():
            p.requires_grad_(self.req[n])


# ---------------------------------------------------------------- scoring one batch
def score_logits(logits, toks, its):
    out = []
    for r, ii, pos, n, cands in its:
        lg = logits[r, pos - 1:pos - 1 + n].float()
        lp = F.log_softmax(lg, -1)
        gold = torch.as_tensor(toks[r, pos:pos + n].astype(np.int64), device=lg.device)
        hit = lp.argmax(-1) == gold
        g0 = lp[0, gold[0]]
        vrank = int((lp[0] > g0).sum()) + 1
        cf = torch.as_tensor(cands, device=lg.device)
        crank = int((lp[0, cf] > g0).sum()) + 1
        out.append((ii, float(lp.gather(1, gold[:, None]).sum()), bool(hit[0]), bool(hit.all()), n, vrank, crank,
                    len(cands)))
    return out


def summarize(res, items):
    by = defaultdict(list)
    for ii, lp, first, exact, n, vr, cr, nc in res:
        rel, form, dist = RELS[items["rel"][ii]], "Q" if items["form"][ii] == 0 else "cloze", int(items["dist"][ii])
        for k in ("ALL", f"rel_{rel}", f"form_{form}", f"dist_{dist}"):
            by[k].append((lp / n, first, exact, vr, cr, nc))
    out = {}
    for k, v in by.items():
        v = np.array(v, float)
        out[k] = dict(n=len(v), exact=float(v[:, 2].mean()), first=float(v[:, 1].mean()), logp_tok=float(v[:, 0].mean()),
                      vrank_mean=float(v[:, 3].mean()), vrank_top1=float((v[:, 3] == 1).mean()),
                      crank_mean=float(v[:, 4].mean()), crank_top1=float((v[:, 4] == 1).mean()),
                      crank_chance=float(((v[:, 5] + 1) / 2).mean()), crank_top1_chance=float((1 / v[:, 5]).mean()))
    return out


def main():
    a = args()
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    t_all = time.time()
    ckpt, data = Path(a.ckpt), Path(a.data)
    meta = json.loads((data / "meta.json").read_text())
    from tokenizers import Tokenizer
    tok = Tokenizer.from_file(str(data / "tokenizer.json"))
    world = json.loads((Path(a.src) / "world.json").read_text())
    names = json.loads((data / "names.json").read_text())["val"]

    # ---- the val streams + items
    SEQ, S, n_seq, L = meta["seq"], meta["val"]["streams"], meta["val"]["seqs_per_stream"], meta["val"]["stream_len"]
    val = np.fromfile(data / "val.bin", dtype=np.uint16).reshape(S, L)
    B = min(a.streams or S, S)
    J = min(a.max_seqs or n_seq, n_seq)
    items = dict(np.load(data / "val_items.npz"))
    wo = dict(np.load(data / "val_worlds.npz"))
    first = lambda s: tok.encode(s).ids[0]
    cf_fixed = [sorted({first(" " + c["name"]) for c in world["cities"]}), sorted({first(" " + j) for j in world["jobs"]}),
                sorted({first(" " + p) for p in world["pets"]}), sorted({first(f" {y}") for y in range(1920, 2006)})]
    name_first = [first(" " + n) for n in names]
    by_seq = defaultdict(list)
    for ii in range(len(items["stream"])):
        s, j = int(items["stream"][ii]), int(items["seq"][ii])
        if s >= B or j >= J:
            continue
        r = int(items["rel"][ii])
        if r == 4:
            cast = wo["cast"][items["world"][ii]]
            cands = sorted({name_first[c] for c in cast if c >= 0 and c != items["name"][ii]})
        else:
            cands = cf_fixed[r]
        by_seq[j].append((s, ii, int(items["pos"][ii]), int(items["n_ans"][ii]), cands))
    n_items = sum(len(v) for v in by_seq.values())
    print(f"[change-fm] {data}: {B} streams x {J} sequences of {SEQ} = {B * J * SEQ:,} tokens, {n_items:,} questions",
          flush=True)

    # ---- load: checkpoint on the CPU, the memory file strict, then the device
    mpath = memory_api.memory_path(ckpt)
    h_file0 = sha256_file(mpath) if a.hash_file and mpath.exists() else None
    la = types.SimpleNamespace(ckpt=str(ckpt), config=a.config, capacity=a.capacity, device="cpu", k=a.k)
    model, step, run_cfg, missing, _ = ew.load_model(la)
    bm = model.bm
    assert isinstance(bm, FastMem), f"expected FastMem, got {type(bm).__name__}"
    assert bm.stream, "this eval is for --fastmem-stream 1"
    assert B <= bm.n_streams
    if mpath.exists():
        obj = memory_api.load_memory_file(mpath, model, strict=True)
        minfo = f"memory file {mpath.name} (step {obj.get('step')}) loaded strict"
        del obj
    else:
        miss = [k for k in missing if k.startswith("bm.")]
        assert not miss, f"no {mpath.name} and the checkpoint lacks {miss[:4]}"
        minfo = "no memory file: embedded memory state"
    model.to(a.device).eval()
    h_brain0, h_mpar0, h_mbuf0 = brain_checksum(model), mem_param_checksum(bm), mem_buf_checksum(bm)
    h_M0 = mem_buf_checksum(bm, skip=())
    print(f"[change-fm] loaded {ckpt} (step {step}); {minfo}; {bm.describe()}; K {model.K}; brain {h_brain0}; memory "
          f"params+D {h_mpar0}; memory bufs {h_mbuf0}; file sha256 {h_file0} ({time.time() - t_all:.0f}s)", flush=True)

    modes = a.modes.split(",")
    R, seq0, commits = {}, {}, 0
    for mode in modes:
        assert mode in ("off", "on_nowrite", "on_write"), mode
        t0 = time.time()
        res = []
        live = Live(model) if mode == "on_write" else None
        ctx = memory_api.memory_off(model) if mode == "off" else live if live else torch.no_grad()
        with ctx, torch.no_grad():
            for j in range(J):
                toks = val[:B, j * SEQ:j * SEQ + SEQ + 1].astype(np.int64)
                x = torch.from_numpy(toks[:, :-1]).to(a.device)
                if live:
                    live.before(B, j)
                with torch.autocast("cuda", dtype=torch.bfloat16, enabled=a.device == "cuda"):
                    logits = model(x)
                if live:
                    live.after()
                if j == 0:
                    seq0[mode] = logits[:, :, :256].float().cpu().clone()
                res += score_logits(logits, toks, by_seq.get(j, []))
                del logits
                if j % max(1, J // 10) == 0 or j == J - 1:
                    e = np.mean([r[3] for r in res]) if res else float("nan")
                    print(f"  {mode}: seq {j + 1}/{J}, {len(res)} questions, exact {e:.4f} ({time.time() - t0:.0f}s)",
                          flush=True)
        if live:
            commits = live.n_commit
        R[mode] = summarize(res, items)
        R[mode]["time_s"] = time.time() - t0
        assert mem_buf_checksum(bm, skip=()) == h_M0, f"{mode}: the memory state was not restored"
    h_brain1, h_mpar1, h_mbuf1 = brain_checksum(model), mem_param_checksum(bm), mem_buf_checksum(bm)
    assert h_brain1 == h_brain0, "brain weights / buffers changed"
    assert h_mpar1 == h_mpar0, "memory parameters / D changed"
    assert h_mbuf1 == h_mbuf0, "memory buffers (D moments) changed"
    h_file1 = sha256_file(mpath) if h_file0 else None
    assert h_file1 == h_file0, "the memory FILE changed"
    chk = {}
    if "on_write" in seq0 and "on_nowrite" in seq0:
        chk["seq0_on_write_vs_on_nowrite_maxdiff"] = float((seq0["on_write"] - seq0["on_nowrite"]).abs().max())
    if "off" in seq0 and "on_nowrite" in seq0:
        chk["seq0_on_nowrite_vs_off_maxdiff"] = float((seq0["on_nowrite"] - seq0["off"]).abs().max())
    peak = torch.cuda.max_memory_allocated() / 1e9 if a.device == "cuda" else None

    # ---- report
    keys = [k for k in sorted(R[modes[0]], key=lambda k: (k != "ALL", k)) if k != "time_s"]
    lines = [f"CHANGING-FACTS eval (FastMem per stream): {ckpt} (step {step}); {B} streams x {J} seqs, {n_items} "
             f"questions; device {a.device}; K {a.k}",
             f"checks: brain {'UNCHANGED' if h_brain1 == h_brain0 else 'CHANGED'}, memory params+D "
             f"{'UNCHANGED' if h_mpar1 == h_mpar0 else 'CHANGED'}, memory bufs {'UNCHANGED' if h_mbuf1 == h_mbuf0 else 'CHANGED'}"
             f", memory file {h_file0} -> {h_file1}; on_write commits {commits}; {chk}",
             f"{'key':14s} " + " ".join(f"{m + ' exact':>17s}" for m in modes) + " " + " ".join(
                 f"{m + ' crank1':>18s}" for m in modes) + f" {'chance':>7s}"]
    for k in keys:
        lines.append(f"{k:14s} " + " ".join(f"{R[m][k]['exact']:17.4f}" for m in modes) + " "
                     + " ".join(f"{R[m][k]['crank_top1']:18.4f}" for m in modes)
                     + f" {R[modes[0]][k]['crank_top1_chance']:7.4f}   (n {R[modes[0]][k]['n']}; lp/tok "
                     + ", ".join(f"{m} {R[m][k]['logp_tok']:.3f}" for m in modes) + "; mean crank "
                     + ", ".join(f"{m} {R[m][k]['crank_mean']:.1f}" for m in modes) + ")")
    for base in ("off", "on_nowrite"):
        if "on_write" in R and base in R:
            A, Z = R["on_write"]["ALL"], R[base]["ALL"]
            lines.append(f"on_write - {base}: exact {A['exact'] - Z['exact']:+.4f}, crank top1 "
                         f"{A['crank_top1'] - Z['crank_top1']:+.4f}, logp/tok {A['logp_tok'] - Z['logp_tok']:+.4f}")
    lines.append(f"total {time.time() - t_all:.0f}s" + (f", CUDA peak {peak:.2f} GB" if peak else ""))
    txt = "\n".join(lines)
    print(txt, flush=True)
    out = Path(a.out) if a.out else \
        HERE / f"{ckpt.parent.name}_{ckpt.stem}_change_fastmem{('_' + a.tag) if a.tag else ''}.json"
    assert "runs" not in out.resolve().parts
    out.write_text(json.dumps(dict(args=vars(a), step=step, results=R, commits=commits, checks=dict(
        brain0=h_brain0, brain1=h_brain1, mem_params0=h_mpar0, mem_params1=h_mpar1, mem_bufs0=h_mbuf0,
        mem_bufs1=h_mbuf1, file0=h_file0, file1=h_file1, **chk), cuda_peak_gb=peak), indent=1))
    out.with_suffix(".txt").write_text(txt + "\n")
    print(f"wrote {out} (+ .txt)", flush=True)


if __name__ == "__main__":
    main()
