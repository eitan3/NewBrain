+def _scores_with_ties(g, R, S):
+    s = torch.randint(0, 4, (R, S), generator=g).float() / 4
+    s[torch.rand(R, S, generator=g) < 0.1] = -0.0                           # -0.0 and +0.0 tie, as in torch.sort
+    return s
