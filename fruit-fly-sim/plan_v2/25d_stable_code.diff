+    _put(sp.touch.view(-1), jj, torch.full_like(j1, step))
+    _put(sp.t_key.view(-1), jj, (sp.t_key.view(-1)[j1].float() + eta * (step - sp.t_key.view(-1)[j1].float())).long())
