+    # ------------------------------------------------------------------ search (no gradient)
+    @torch.no_grad()
+    def _rerank(self, q, cand, k):
+        """Exact fp32 distances of global candidates cand (N, M) (-1 = none) -> top-k (idx, d2 ascending; +inf = none)."""
+        return rerank(q, self.glob.key, self.glob.occ, cand, k)
