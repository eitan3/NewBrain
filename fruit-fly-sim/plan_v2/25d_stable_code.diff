+    @torch.no_grad()
+    def _rerank_priv(self, q, spaces, cand, k):
+        """Private candidates (n, M) in spaces (n,) -> (flat slot ids (n, k), d2 (n, k)) by the exact fp32 distance."""
+        sp = self.priv
+        flat = spaces[:, None] * self.P + cand
+        d2 = (q[:, None, :] - sp.key.view(-1, self.kd)[flat]).pow(2).sum(-1)
