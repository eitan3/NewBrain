+def match_features(A, d1, d2, h0, mature, age, empty):
+    """The 8 match features of one space (all (n,)): A, d1/h0^2, log(d2/d1), maturity/3, log(1 + age), empty flag,
+    log d1, log(d2 - d1)."""
