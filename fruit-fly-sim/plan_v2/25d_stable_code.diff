+            up0, _, _ = bm._read(qd[t_k], bm.priv, pf[:, :kp], bm.h0_p, grad=False, stats=False)  # reads for the
+            us0, _, _ = bm._read(qd, bm.priv, sf[:, :kp], bm.h0_p, grad=False, stats=False)       # content-fit)
+            if rec_on:
+                gate.observe_prior(gm, torch.cat([pm, smt]))
