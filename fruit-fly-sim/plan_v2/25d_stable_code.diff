+                     torch.where(ok, torch.log(d1 + 1e-6), torch.zeros_like(d1)),
+                     torch.where(fin, torch.log((d2 - d1).clamp(min=0) + 1e-6), torch.zeros_like(d1))], -1)
+    return f.float()
