+    ok = ~empty
+    fin = ok & torch.isfinite(d2)
+    r = torch.where(fin, torch.log((d2 + 1e-6) / (d1 + 1e-6)), torch.zeros_like(d1))
+    f = torch.stack([A, torch.where(ok, d1 / h2, torch.zeros_like(d1)), r, torch.where(ok, mature / 3.0, 0 * d1),
