+    eta = torch.maximum(1.0 / (n_j + 2), torch.full_like(n_j, 0.25))
+    K = sp.key.view(-1, bm.kd)
+    dk = eta[:, None] * (keys - K[j1])
+    lim = torch.minimum(sig2.sqrt(), 0.5 * h2.sqrt())
