+                if torch.is_tensor(v):
+                    self._wcount[k] = self._wcount.get(k, 0) + v
+                elif isinstance(v, dict):
+                    for k2, v2 in v.items():
+                        self._wcount[f"{k}_{k2}"] = self._wcount.get(f"{k}_{k2}", 0) + v2
+            self._last_writes = {}
