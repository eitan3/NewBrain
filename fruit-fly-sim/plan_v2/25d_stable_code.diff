+        o2 = oa[sid[oa].argsort(stable=True)]                                                     # by space (stable)
+        s_sorted = sid[o2]
+        f2 = torch.ones_like(s_sorted, dtype=torch.bool)
+        f2[1:] = s_sorted[1:] != s_sorted[:-1]
